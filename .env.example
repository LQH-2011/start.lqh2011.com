# Copy to .env for local `npm run dev` testing (never commit .env).
# The same values go into the Vercel project env vars (see README).
DATABASE_URL=postgres://USER:PASSWORD@HOST/dbname?sslmode=require
AUTH_PASSWORD_HASH=scrypt$<salt_hex>$<hash_hex>
AUTH_TOKEN_SECRET=<random hex, e.g. openssl rand -hex 32>
# Comma-separated list of origins allowed to call the API. Add the preview
# alias domain so the page works from preview.lqh2011.com too.
ALLOWED_ORIGIN=https://start.lqh2011.com,https://preview.lqh2011.com
# Local-only: the API verifies Neon's TLS cert by default. Set this to false
# only when your local Postgres uses a self-signed cert (dev/testing).
# PGSSL_REJECT_UNAUTHORIZED=false

# ---- AI chat (start page) ----
# OpenAI-compatible provider used by the built-in chat (api/chat.js proxies a
# streaming /chat/completions call). Set these in the Vercel project env vars
# AND in local .env for `npm run dev`. Base URL without a trailing slash, e.g.
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_MODEL=deepseek-chat
#   AI_API_KEY=sk-...
# The API is never exposed to the browser: the key lives only server-side.
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
