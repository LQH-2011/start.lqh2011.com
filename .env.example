# Copy to .env for local `npm run dev` testing (never commit .env).
# The same values go into the Vercel project env vars (see README).
DATABASE_URL=postgres://USER:PASSWORD@HOST/dbname?sslmode=require
AUTH_PASSWORD_HASH=scrypt$<salt_hex>$<hash_hex>
AUTH_TOKEN_SECRET=<random hex, e.g. openssl rand -hex 32>
ALLOWED_ORIGIN=https://start.lqh2011.com
# Local-only: the API verifies Neon's TLS cert by default. Set this to false
# only when your local Postgres uses a self-signed cert (dev/testing).
# PGSSL_REJECT_UNAUTHORIZED=false
